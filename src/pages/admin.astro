<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Trị Bài Viết | Cẩm Nang Xe Đạp</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline>
      // Tự động xóa token lỗi ("undefined") bị lưu kẹt trong trình duyệt
      try {
        ['decap-cms-user', 'netlify-cms-user'].forEach(function (key) {
          var raw = localStorage.getItem(key);
          if (raw) {
            var parsed = JSON.parse(raw);
            if (!parsed.token || parsed.token === 'undefined' || parsed.backendName === 'test-repo') {
              localStorage.removeItem(key);
            }
          }
        });
      } catch (e) {
        localStorage.removeItem('decap-cms-user');
        localStorage.removeItem('netlify-cms-user');
      }
    </script>
    <script src="https://unpkg.com/decap-cms@^3.1.2/dist/decap-cms.js"></script>
  </body>
</html>
