---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PartnerBox from '../components/PartnerBox.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredPosts = sortedPosts.filter((p) => p.data.featured);
---

<BaseLayout 
  title="Cổng Thông Tin Kiến Thức & Đánh Giá Xe Đạp" 
  description="Trang cẩm nang chia sẻ kinh nghiệm chọn mua xe đạp thể thao, xe touring, hướng dẫn bảo dưỡng líp xích và kỹ thuật đạp xe."
>
  <!-- BANNER CÔNG NGHỆ VECTOR -->
  <section class="tech-animated-hero relative text-white py-24 px-4 text-center overflow-hidden">
    <div class="absolute inset-0 tech-grid-overlay pointer-events-none"></div>
    <div class="aurora-glow pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto">
      <!-- Tag vi mạch công nghệ SVG -->
      <div class="inline-flex items-center gap-2.5 bg-slate-950/70 backdrop-blur-md border border-cyan-400 px-4 py-1.5 rounded-full text-xs font-bold text-cyan-300 mb-6 shadow-[0_0_15px_rgba(6,182,212,0.35)]">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
        <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="17" r="3.5"/>
          <circle cx="6" cy="17" r="3.5"/>
          <path d="M6 17h5l3-7h4"/>
          <path d="M12 17l-3-7"/>
          <path d="M15 6h2"/>
        </svg>
        <span>Chuyên Trang Cẩm Nang Kỹ Thuật & Đánh Giá Xe Đạp</span>
      </div>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black mb-5 leading-tight tracking-tight drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)]">
        Làm Chủ Mọi Cung Đường <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-100 to-teal-200">
          Cùng Chiếc Xe Của Bạn
        </span>
      </h1>

      <p class="text-cyan-50 text-sm md:text-base max-w-2xl mx-auto mb-8 font-normal leading-relaxed drop-shadow">
        Tổng hợp cẩm nang chọn xe chuẩn vóc dáng, kỹ thuật tự cân chỉnh líp xích tại nhà và kinh nghiệm chinh phục các hành trình đi tour dài ngày.
      </p>

      <!-- Khung tìm kiếm với Icon kính lúp SVG phẳng -->
      <div class="max-w-xl mx-auto relative flex items-center shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
        <div class="absolute left-4 text-cyan-400 pointer-events-none">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </div>
        <input 
          type="text" 
          placeholder="Tìm kiếm: size xe, vệ sinh xích líp, chọn xe touring..." 
          class="w-full bg-slate-950/75 backdrop-blur-md border-2 border-cyan-400/60 text-white placeholder-cyan-200/60 text-sm rounded-2xl pl-11 pr-28 py-3.5 focus:outline-none focus:border-cyan-300 focus:ring-4 focus:ring-cyan-500/20 transition-all"
        />
        <button class="absolute right-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95 flex items-center gap-1.5">
          <span>Tìm kiếm</span>
        </button>
      </div>
    </div>
  </section>

  <!-- NỘI DUNG CHÍNH -->
  <main class="max-w-6xl mx-auto px-4 py-12">
    {featuredPosts.length > 0 && (
      <section class="mb-14">
        <div class="flex items-center gap-2.5 mb-6 border-l-4 border-brand-600 pl-3">
          <div class="p-1.5 rounded-lg bg-brand-50 text-brand-600">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-brand-900 tracking-tight">Bài Viết Nổi Bật</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredPosts.map((post) => (
            <PostCard 
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              date={post.data.pubDate}
              readTime={post.data.readTime}
              image={post.data.image}
            />
          ))}
        </div>
      </section>
    )}

    <PartnerBox />

    <section class="mt-14">
      <div class="flex items-center gap-2.5 mb-6 border-l-4 border-brand-600 pl-3">
        <div class="p-1.5 rounded-lg bg-brand-50 text-brand-600">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-brand-900 tracking-tight">Cẩm Nang Mới Nhất</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <PostCard 
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            category={post.data.category}
            date={post.data.pubDate}
            readTime={post.data.readTime}
            image={post.data.image}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tech-animated-hero {
    background: linear-gradient(125deg, #051329, #0369a1, #0284c7, #1e3a8a, #0891b2, #091b38);
    background-size: 300% 300%;
    animation: vividTechWave 10s ease-in-out infinite alternate;
  }
  @keyframes vividTechWave {
    0% { background-position: 0% 20%; }
    50% { background-position: 100% 80%; }
    100% { background-position: 20% 100%; }
  }
  .aurora-glow {
    position: absolute;
    top: -50%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.28), rgba(37, 99, 235, 0.15), transparent 60%);
    animation: auroraMove 12s ease-in-out infinite alternate;
  }
  @keyframes auroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(15%, 15%) scale(1.15); }
  }
  .tech-grid-overlay {
    background-image: 
      linear-gradient(to right, rgba(56, 189, 248, 0.25) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(56, 189, 248, 0.25) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 85%);
  }
</style>