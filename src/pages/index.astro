---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PartnerBox from '../components/PartnerBox.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredPosts = sortedPosts.filter((p) => p.data.featured);
---

<BaseLayout 
  title="Cổng Thông Tin Kiến Thức & Đánh Giá Xe Đạp" 
  description="Trang cẩm nang chia sẻ kinh nghiệm chọn mua xe đạp thể thao, xe touring, hướng dẫn bảo dưỡng líp xích và kỹ thuật đạp xe."
>
  <!-- ================= BANNER CÔNG NGHỆ CHUYỂN MÀU TỪ TỪ ================= -->
  <section class="tech-animated-hero relative text-white py-20 px-4 text-center overflow-hidden">
    
    <!-- Lớp lưới họa tiết công nghệ mờ (Tech Grid Pattern) -->
    <div class="absolute inset-0 tech-grid-overlay opacity-25 pointer-events-none"></div>

    <!-- Đốm sáng mờ chuyển động nhẹ tạo chiều sâu 3D -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-cyan-400/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

    <div class="relative z-10 max-w-4xl mx-auto">
      <!-- Tag phong cách Cyber/Tech -->
      <div class="inline-flex items-center gap-2 bg-slate-950/50 backdrop-blur-md border border-cyan-400/40 px-4 py-1.5 rounded-full text-xs font-semibold text-cyan-300 mb-6 shadow-sm">
        <span class="inline-block w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        <span>🚴 Cẩm Nang Kiến Thức & Kỹ Thuật Xe Đạp Độc Lập</span>
      </div>

      <!-- Tiêu đề lớn đổ bóng sáng -->
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black mb-5 leading-tight tracking-tight drop-shadow-md">
        Làm Chủ Mọi Cung Đường <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-blue-200">
          Cùng Chiếc Xe Của Bạn
        </span>
      </h1>

      <p class="text-cyan-100/90 text-sm md:text-base max-w-2xl mx-auto mb-8 font-light leading-relaxed">
        Tổng hợp cẩm nang chọn xe chuẩn vóc dáng, kỹ thuật tự cân chỉnh líp xích tại nhà và kinh nghiệm chinh phục các hành trình đi tour dài ngày.
      </p>

      <!-- Khung tìm kiếm phong cách viền phát sáng -->
      <div class="max-w-xl mx-auto relative flex items-center shadow-2xl">
        <input 
          type="text" 
          placeholder="Tìm cẩm nang: size xe, vệ sinh xích líp, chọn xe touring..." 
          class="w-full bg-slate-950/60 backdrop-blur-md border border-cyan-500/40 text-white placeholder-cyan-200/60 text-sm rounded-2xl pl-11 pr-28 py-3.5 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-transparent transition-all"
        />
        <span class="absolute left-4 text-cyan-300 text-sm">🔍</span>
        <button class="absolute right-2 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95">
          Tìm kiếm
        </button>
      </div>
    </div>
  </section>

  <!-- ================= THÂN TRANG CHỦ ================= -->
  <main class="max-w-6xl mx-auto px-4 py-12">
    {featuredPosts.length > 0 && (
      <section class="mb-14">
        <h2 class="text-2xl font-bold text-brand-900 border-l-4 border-brand-600 pl-3 mb-6 flex items-center gap-2">
          <span>🔥</span>
          <span>Bài Viết Nổi Bật</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredPosts.map((post) => (
            <PostCard 
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              date={post.data.pubDate}
              readTime={post.data.readTime}
              image={post.data.image}
            />
          ))}
        </div>
      </section>
    )}

    <PartnerBox />

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-brand-900 border-l-4 border-brand-600 pl-3 mb-6 flex items-center gap-2">
        <span>📚</span>
        <span>Bài Viết Mới Nhất</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <PostCard 
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            category={post.data.category}
            date={post.data.pubDate}
            readTime={post.data.readTime}
            image={post.data.image}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<!-- ================= CSS HIỆU ỨNG CHUYỂN MÀU CÔNG NGHỆ CHẬM ================= -->
<style>
  /* Hiệu ứng màu gradient chuyển động trôi chậm êm ái */
  .tech-animated-hero {
    background: linear-gradient(
      -45deg, 
      #07172c, 
      #0f2744, 
      #1e3a8a, 
      #0369a1, 
      #1d4ed8, 
      #081b33
    );
    background-size: 350% 350%;
    animation: smoothTechWave 14s ease infinite;
  }

  @keyframes smoothTechWave {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Họa tiết lưới công nghệ (Tech Grid Overlay) */
  .tech-grid-overlay {
    background-image: 
      linear-gradient(to right, rgba(2, 132, 199, 0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(2, 132, 199, 0.15) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0) 80%);
  }
</style>