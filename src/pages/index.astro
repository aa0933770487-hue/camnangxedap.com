---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PartnerBox from '../components/PartnerBox.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredPosts = sortedPosts.filter((p) => p.data.featured);

const searchablePosts = sortedPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  slug: p.slug,
  image: p.data.image || "https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=400&q=80",
}));
---

<BaseLayout 
  title="Cổng Thông Tin Kiến Thức & Đánh Giá Xe Đạp" 
  description="Trang cẩm nang chia sẻ kinh nghiệm chọn mua xe đạp thể thao, xe touring, hướng dẫn bảo dưỡng líp xích và kỹ thuật đạp xe."
>
  <!-- BANNER GIỮ ĐÚNG GIAO DIỆN ĐẸP BAN ĐẦU -->
  <section class="tech-animated-hero relative text-white py-24 px-4 text-center">
    <!-- Bọc riêng hiệu ứng nền trong overflow-hidden để không cắt mất bảng gợi ý tìm kiếm -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute inset-0 tech-grid-overlay"></div>
      <div class="aurora-glow"></div>
    </div>

    <div class="relative z-20 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2.5 bg-slate-950/70 backdrop-blur-md border border-cyan-400 px-4 py-1.5 rounded-full text-xs font-bold text-cyan-300 mb-6 shadow-[0_0_15px_rgba(6,182,212,0.35)]">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
        <span>🚴 Cẩm Nang Kiến Thức & Kỹ Thuật Xe Đạp Độc Lập</span>
      </div>

      <!-- Tiêu đề căn chỉnh chuẩn xác -->
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black mb-6 tracking-tight drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)]">
        <span class="block text-white leading-tight">
          Làm Chủ Mọi Cung Đường
        </span>
        <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-100 to-teal-200 leading-tight">
          Cùng Chiếc Xe Của Bạn
        </span>
      </h1>

      <p class="text-cyan-50 text-sm md:text-base max-w-2xl mx-auto mb-8 font-normal leading-relaxed drop-shadow">
        Tổng hợp cẩm nang chọn xe chuẩn vóc dáng, kỹ thuật tự cân chỉnh líp xích tại nhà và kinh nghiệm chinh phục các hành trình đi tour dài ngày.
      </p>

      <!-- Thanh tìm kiếm giữ nguyên thiết kế nút "Tìm kiếm" như lúc đầu -->
      <div class="max-w-xl mx-auto relative">
        <div class="relative flex items-center rounded-2xl">
          <input 
            id="hero-search-input"
            type="text" 
            autocomplete="off"
            placeholder="Tìm cẩm nang: size xe, vệ sinh xích líp, chọn xe touring..." 
            class="w-full bg-slate-950/75 backdrop-blur-md border-2 border-cyan-400/60 text-white placeholder-cyan-200/60 text-sm rounded-2xl pl-11 pr-28 py-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.45)] focus:outline-none focus:border-cyan-300 focus:ring-4 focus:ring-cyan-500/20 transition-all"
          />
          <span class="absolute left-4 text-cyan-300 text-sm pointer-events-none">🔍</span>
          <button 
            id="hero-search-btn"
            type="button"
            class="absolute right-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95"
          >
            Tìm kiếm
          </button>
        </div>

        <!-- Bảng gợi ý xổ xuống mượt mà, không bị cắt -->
        <div 
          id="hero-search-results" 
          class="hidden absolute left-0 right-0 top-full mt-2 bg-slate-900/95 backdrop-blur-xl border border-cyan-400/50 rounded-2xl shadow-2xl overflow-hidden z-50 max-h-[340px] overflow-y-auto divide-y divide-slate-800 text-left"
        ></div>
      </div>
    </div>
  </section>

  <!-- THÂN TRANG CHỦ NGUYÊN BẢN -->
  <main class="max-w-6xl mx-auto px-4 py-12">
    {featuredPosts.length > 0 && (
      <section class="mb-14">
        <h2 class="text-2xl font-bold text-brand-900 border-l-4 border-brand-600 pl-3 mb-6 flex items-center gap-2">
          <span>🔥</span>
          <span>Bài Viết Nổi Bật</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredPosts.map((post) => (
            <PostCard 
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              date={post.data.pubDate}
              readTime={post.data.readTime}
              image={post.data.image}
            />
          ))}
        </div>
      </section>
    )}

    <PartnerBox />

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-brand-900 border-l-4 border-brand-600 pl-3 mb-6 flex items-center gap-2">
        <span>📚</span>
        <span>Bài Viết Mới Nhất</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <PostCard 
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            category={post.data.category}
            date={post.data.pubDate}
            readTime={post.data.readTime}
            image={post.data.image}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline define:vars={{ searchablePosts }}>
  (function() {
    const input = document.getElementById('hero-search-input');
    const btn = document.getElementById('hero-search-btn');
    const resultsBox = document.getElementById('hero-search-results');
    const posts = searchablePosts || [];

    function removeTones(str) {
      if (!str) return '';
      return str.toLowerCase()
        .replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, 'a')
        .replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, 'e')
        .replace(/ì|í|ị|ỉ|ĩ/g, 'i')
        .replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, 'o')
        .replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, 'u')
        .replace(/ỳ|ý|ỵ|ỷ|ỹ/g, 'y')
        .replace(/đ/g, 'd')
        .trim();
    }

    function runSearch() {
      const q = input.value.trim();
      const cleanQ = removeTones(q);
      if (!cleanQ) {
        resultsBox.classList.add('hidden');
        return;
      }
      const matched = posts.filter(p => removeTones(`${p.title} ${p.description} ${p.category}`).includes(cleanQ));
      if (!matched.length) {
        resultsBox.innerHTML = `<div class="p-4 text-center text-slate-300 text-xs">Không tìm thấy cẩm nang phù hợp với "<strong>${q}</strong>"</div>`;
        resultsBox.classList.remove('hidden');
        return;
      }
      resultsBox.innerHTML = matched.slice(0, 5).map(item => `
        <a href="/${item.slug}" class="flex items-center gap-3 p-3 hover:bg-slate-800/80 transition group">
          <img src="${item.image}" class="w-12 h-12 rounded-xl object-cover border border-slate-700 flex-shrink-0" />
          <div class="min-w-0 flex-grow">
            <span class="text-[10px] font-bold text-cyan-400 uppercase block">${item.category}</span>
            <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-cyan-300 truncate">${item.title}</h4>
            <p class="text-[11px] text-slate-400 truncate">${item.description}</p>
          </div>
          <span class="text-cyan-400 text-xs font-bold pr-1">&rarr;</span>
        </a>
      `).join('');
      resultsBox.classList.remove('hidden');
    }

    input?.addEventListener('input', runSearch);
    input?.addEventListener('focus', runSearch);
    btn?.addEventListener('click', runSearch);

    document.addEventListener('click', (e) => {
      if (!input?.contains(e.target) && !resultsBox?.contains(e.target) && !btn?.contains(e.target)) {
        resultsBox?.classList.add('hidden');
      }
    });
  })();
</script>

<style>
  .tech-animated-hero {
    background: linear-gradient(125deg, #051329, #0369a1, #0284c7, #1e3a8a, #0891b2, #091b38);
    background-size: 300% 300%;
    animation: vividTechWave 10s ease-in-out infinite alternate;
  }
  @keyframes vividTechWave {
    0% { background-position: 0% 20%; }
    50% { background-position: 100% 80%; }
    100% { background-position: 20% 100%; }
  }
  .aurora-glow {
    position: absolute;
    top: -50%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.28), rgba(37, 99, 235, 0.15), transparent 60%);
    animation: auroraMove 12s ease-in-out infinite alternate;
  }
  @keyframes auroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(15%, 15%) scale(1.15); }
  }
  .tech-grid-overlay {
    background-image: 
      linear-gradient(to right, rgba(56, 189, 248, 0.25) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(56, 189, 248, 0.25) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 40%, rgba(0, 0, 0, 0) 85%);
  }
</style>