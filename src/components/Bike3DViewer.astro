---
interface Props {
  title?: string;
  defaultColor?: string;
  wheelSize?: string;
  handlebarType?: string;
  productLink?: string;
}

const { 
  title = "Mô hình 3D dựng theo thông số thực tế",
  defaultColor = "#2563eb",
  wheelSize = "700c",
  handlebarType = "flat",
  productLink = "https://shopxedap-chinh.com"
} = Astro.props;
---

<!-- NÚT GÓC PHẢI MỞ 3D -->
<div class="fixed bottom-6 right-6 z-40">
  <button 
    id="open-3d-btn"
    type="button"
    class="group relative flex items-center gap-3 bg-gradient-to-r from-slate-950 via-brand-900 to-blue-950 text-white pl-3.5 pr-5 py-3 rounded-2xl shadow-[0_10px_25px_rgba(37,99,235,0.45)] border-2 border-cyan-400 hover:border-white hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer"
  >
    <span class="absolute -top-1 -right-1 flex h-4 w-4">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-4 w-4 bg-cyan-500 border border-white"></span>
    </span>

    <div class="w-9 h-9 rounded-xl bg-blue-600/40 border border-cyan-400/50 flex items-center justify-center text-cyan-300 shadow-inner group-hover:rotate-12 transition-transform">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
        <line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
    </div>

    <div class="text-left">
      <div class="flex items-center gap-1.5">
        <span class="text-[10px] font-black uppercase tracking-wider bg-cyan-400 text-slate-950 px-1.5 py-0.5 rounded leading-none">
          3D Tự Build
        </span>
        <span class="text-[11px] text-cyan-200 font-semibold">Theo thông số thực</span>
      </div>
      <div class="text-xs font-bold text-white tracking-wide">
        Mô Hình 3D Chuẩn X
      </div>
    </div>
  </button>
</div>

<!-- MODAL 3D -->
<div 
  id="modal-3d" 
  data-default-color={defaultColor}
  data-wheel-size={wheelSize}
  data-handlebar={handlebarType}
  class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md hidden items-center justify-center p-3 sm:p-6 transition-opacity duration-300"
>
  <div class="relative w-full max-w-4xl bg-slate-900 rounded-3xl border border-slate-700 shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
    <div class="px-5 py-3.5 bg-slate-950 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-cyan-400 animate-pulse"></span>
        <h3 class="text-sm font-bold text-white tracking-wide uppercase">{title}</h3>
      </div>

      <div class="flex items-center gap-4">
        <div class="flex items-center gap-1.5 bg-slate-900 px-2.5 py-1 rounded-full border border-slate-800">
          <span class="text-slate-400 text-[11px]">Đổi Màu:</span>
          <button data-color="#2563eb" class="color-btn w-4 h-4 rounded-full bg-blue-600 border border-white hover:scale-125 transition cursor-pointer" title="Xanh Royal"></button>
          <button data-color="#0284c7" class="color-btn w-4 h-4 rounded-full bg-sky-500 hover:scale-125 transition cursor-pointer" title="Xanh Cyan"></button>
          <button data-color="#dc2626" class="color-btn w-4 h-4 rounded-full bg-red-600 hover:scale-125 transition cursor-pointer" title="Đỏ Thể Thao"></button>
          <button data-color="#09090b" class="color-btn w-4 h-4 rounded-full bg-zinc-950 border border-slate-600 hover:scale-125 transition cursor-pointer" title="Đen Nhám"></button>
          <button data-color="#94a3b8" class="color-btn w-4 h-4 rounded-full bg-slate-400 hover:scale-125 transition cursor-pointer" title="Bạc Kim Loại"></button>
        </div>

        <button 
          id="close-3d-btn"
          class="w-8 h-8 rounded-full bg-slate-800 hover:bg-red-600 text-slate-300 hover:text-white flex items-center justify-center font-bold text-base transition cursor-pointer"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- KHUNG RENDER -->
    <div class="relative w-full h-[440px] sm:h-[500px] bg-gradient-to-b from-slate-900 via-[#071324] to-slate-950 flex-grow">
      <div id="modal-bike-canvas" class="w-full h-full cursor-grab active:cursor-grabbing"></div>

      <div class="absolute bottom-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
        <div class="flex flex-wrap gap-1.5 pointer-events-auto bg-slate-950/85 backdrop-blur-md p-1.5 rounded-xl border border-slate-800">
          <button data-cam="overview" class="cam-btn px-2.5 py-1 rounded-lg bg-brand-600 text-white text-[11px] font-semibold transition cursor-pointer">Toàn cảnh</button>
          <button data-cam="drivetrain" class="cam-btn px-2.5 py-1 rounded-lg hover:bg-slate-800 text-slate-300 text-[11px] font-medium transition cursor-pointer">Đùi đĩa</button>
          <button data-cam="cockpit" class="cam-btn px-2.5 py-1 rounded-lg hover:bg-slate-800 text-slate-300 text-[11px] font-medium transition cursor-pointer">Ghi đông</button>
        </div>
        <span class="hidden sm:inline-block bg-slate-950/70 text-slate-400 text-[11px] px-3 py-1 rounded-lg border border-slate-800">
          🖱️ Kéo chuột xoay 360° • Lăn chuột phóng to
        </span>
      </div>
    </div>

    <div class="px-5 py-3 bg-slate-950 border-t border-slate-800 flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs text-slate-400">Mô hình 3D tự động build theo thông số cấu hình thực tế</span>
      <a 
        href={productLink} 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow flex items-center gap-1.5"
      >
        <span>Xem Giá & Đặt Mua Tại Cửa Hàng</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</div>

<script type="module">
  import * as THREE from 'https://esm.sh/three@0.160.0';
  import { OrbitControls } from 'https://esm.sh/three@0.160.0/examples/jsm/controls/OrbitControls.js';

  const openBtn = document.getElementById('open-3d-btn');
  const closeBtn = document.getElementById('close-3d-btn');
  const modal = document.getElementById('modal-3d');
  const container = document.getElementById('modal-bike-canvas');

  const initialColor = modal?.getAttribute('data-default-color') || '#2563eb';
  const wheelParam = modal?.getAttribute('data-wheel-size') || '700c';
  const handlebarParam = modal?.getAttribute('data-handlebar') || 'flat';

  let scene, camera, renderer, controls, frameMat, crankGroup;
  let isInitialized = false;
  const wheels = [];

  function initThree() {
    if (isInitialized || !container) return;
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0.5, 3.4);

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.8;
    controls.target.set(0, 0.25, 0);

    scene.add(new THREE.AmbientLight(0xffffff, 1.1));
    const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
    keyLight.position.set(4, 7, 5);
    scene.add(keyLight);

    const floorGrid = new THREE.GridHelper(8, 30, 0x0284c7, 0x1e293b);
    floorGrid.position.y = -0.68;
    scene.add(floorGrid);

    frameMat = new THREE.MeshStandardMaterial({ color: new THREE.Color(initialColor), metalness: 0.9, roughness: 0.15 });
    const darkMat = new THREE.MeshStandardMaterial({ color: 0x18181b, metalness: 0.5, roughness: 0.5 });
    const chromeMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, metalness: 0.95, roughness: 0.1 });
    const tireRadius = wheelParam === '26' ? 0.54 : 0.62; // Tự động co giãn kích thước bánh xe theo thông số thực tế

    const bikeGroup = new THREE.Group();
    scene.add(bikeGroup);

    function createTube(p1, p2, radius, mat) {
      const v1 = new THREE.Vector3(...p1);
      const v2 = new THREE.Vector3(...p2);
      const dir = new THREE.Vector3().subVectors(v2, v1);
      const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius * 0.92, dir.length(), 24), mat);
      mesh.position.copy(v1).add(v2).multiplyScalar(0.5);
      mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.clone().normalize());
      return mesh;
    }

    function createWheel(xPos) {
      const g = new THREE.Group();
      g.position.set(xPos, 0, 0);
      g.add(new THREE.Mesh(new THREE.TorusGeometry(tireRadius, 0.05, 16, 40), tireMat));
      g.add(new THREE.Mesh(new THREE.TorusGeometry(tireRadius - 0.06, 0.022, 12, 40), chromeMat));
      const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.045, 0.18, 16), chromeMat);
      hub.rotation.x = Math.PI / 2;
      g.add(hub);
      wheels.push(g);
      return g;
    }

    const wheelDist = wheelParam === '26' ? 1.0 : 1.1;
    bikeGroup.add(createWheel(-wheelDist));
    bikeGroup.add(createWheel(wheelDist));

    // Khung sườn tự build theo tỷ lệ thực tế
    const BB = [-0.25, -0.08, 0];
    const ST = [-0.48, 0.78, 0];
    const HT = [0.62, 0.86, 0];

    bikeGroup.add(createTube(BB, ST, 0.036, frameMat));
    bikeGroup.add(createTube([-0.46, 0.74, 0], [0.64, 0.81, 0], 0.032, frameMat));
    bikeGroup.add(createTube(BB, [0.68, 0.60, 0], 0.042, frameMat));
    bikeGroup.add(createTube(HT, [0.74, 0.58, 0], 0.04, frameMat));
    bikeGroup.add(createTube(BB, [-wheelDist, 0, 0.09], 0.022, frameMat));
    bikeGroup.add(createTube(BB, [-wheelDist, 0, -0.09], 0.022, frameMat));

    // Tự build kiểu ghi đông theo thông số Admin (Ghi đông ngang hay ghi đông uốn cong)
    bikeGroup.add(createTube(HT, [0.58, 1.0, 0], 0.026, darkMat));
    if (handlebarParam === 'drop') {
      // Ghi đông cong sừng dê (Road/Touring)
      bikeGroup.add(createTube([0.58, 1.03, 0], [0.72, 1.03, 0], 0.018, chromeMat));
      bikeGroup.add(createTube([0.72, 1.03, -0.38], [0.72, 1.03, 0.38], 0.018, chromeMat));
    } else {
      // Ghi đông ngang thể thao (MTB/Hybrid)
      bikeGroup.add(createTube([0.58, 1.0, 0], [0.76, 1.02, 0], 0.026, darkMat));
      bikeGroup.add(createTube([0.76, 1.02, -0.44], [0.76, 1.02, 0.44], 0.018, chromeMat));
    }

    bikeGroup.add(createTube(ST, [-0.54, 1.0, 0], 0.024, chromeMat));
    const saddle = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.06, 0.15), darkMat);
    saddle.position.set(-0.56, 1.02, 0);
    bikeGroup.add(saddle);

    // Đùi đĩa quay
    crankGroup = new THREE.Group();
    crankGroup.position.set(...BB);
    const chainring = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.012, 28), chromeMat);
    chainring.rotation.x = Math.PI / 2;
    crankGroup.add(chainring);
    bikeGroup.add(crankGroup);

    document.querySelectorAll('.color-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const hex = e.currentTarget.getAttribute('data-color');
        if (hex && frameMat) frameMat.color.set(hex);
      });
    });

    const camPresets = {
      overview: { pos: [0, 0.5, 3.4], target: [0, 0.25, 0], autoRotate: true },
      drivetrain: { pos: [-0.65, -0.05, 1.4], target: [-0.25, -0.05, 0], autoRotate: false },
      cockpit: { pos: [0.8, 1.2, 1.2], target: [0.65, 0.9, 0], autoRotate: false },
    };

    document.querySelectorAll('.cam-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const key = e.currentTarget.getAttribute('data-cam');
        const p = camPresets[key];
        if (!p) return;
        camera.position.set(...p.pos);
        controls.target.set(...p.target);
        controls.autoRotate = p.autoRotate;
        controls.update();
      });
    });

    function animate() {
      requestAnimationFrame(animate);
      wheels.forEach((w) => { w.rotation.z -= 0.015; });
      if (crankGroup) crankGroup.rotation.z -= 0.015;
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
    isInitialized = true;
  }

  openBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    initThree();
    setTimeout(() => {
      if (renderer && container) {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      }
    }, 50);
  });

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
</script>