---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  date: Date;
  readTime: string;
  image?: string;
}

const { title, description, slug, category, date, readTime, image } = Astro.props;

// Ảnh mặc định chất lượng cao tông xanh nếu bài viết chưa up thumbnail
const fallbackImage = "https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=800&q=80";
const displayImage = image && image.trim() !== "" ? image : fallbackImage;
---

<article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-brand-500 transition duration-300 flex flex-col group">
  <a href={`/${slug}`} class="aspect-video w-full overflow-hidden relative block bg-slate-100">
    <img 
      src={displayImage} 
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <span class="absolute top-3 left-3 bg-brand-900/90 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md shadow-sm">
      {category}
    </span>
  </a>

  <div class="p-5 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2.5">
      <time>{date.toLocaleDateString('vi-VN')}</time>
      <span>•</span>
      <span>{readTime} đọc</span>
    </div>

    <h2 class="text-base md:text-lg font-bold text-slate-900 mb-2 leading-snug group-hover:text-brand-600 transition-colors">
      <a href={`/${slug}`}>
        {title}
      </a>
    </h2>

    <p class="text-slate-600 text-xs md:text-sm line-clamp-2 mb-4 flex-grow leading-relaxed">
      {description}
    </p>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-600">
      <span>Xem cẩm nang</span>
      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
    </div>
  </div>
</article>
