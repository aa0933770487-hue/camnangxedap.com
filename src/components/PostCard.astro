---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  date: Date;
  readTime: string;
}

const { title, description, slug, category, date, readTime } = Astro.props;
---

<article class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-brand-500 transition duration-200 flex flex-col group">
  <div class="h-44 bg-gradient-to-br from-brand-50 to-brand-100 flex items-center justify-center border-b border-slate-100 relative">
    <span class="text-4xl text-brand-600/40 group-hover:scale-110 transition-transform">🚲</span>
    <span class="absolute top-3 left-3 bg-brand-900 text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded">
      {category}
    </span>
  </div>

  <div class="p-5 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
      <time>{date.toLocaleDateString('vi-VN')}</time>
      <span>•</span>
      <span>{readTime} đọc</span>
    </div>

    <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug group-hover:text-brand-600 transition-colors">
      <a href={`/${slug}`}>
        {title}
      </a>
    </h2>

    <p class="text-slate-600 text-sm line-clamp-3 mb-4 flex-grow leading-relaxed">
      {description}
    </p>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-600">
      <span>Đọc chi tiết</span>
      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
    </div>
  </div>
</article>
